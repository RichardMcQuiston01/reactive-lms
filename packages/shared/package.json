{
  "name": "@richardmcquiston01/reactive-lms-shared",
  "version": "0.4.0",
  "description": "Shared contracts, DTOs, errors and the SCORM 1.2 data model for ReactiveLMS.",
  "keywords": [
    "lms",
    "scorm",
    "contracts",
    "dto"
  ],
  "license": "MIT",
  "author": "Richard McQuiston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/reactive-lms.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/RichardMcQuiston01/reactive-lms#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/reactive-lms/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "prepack": "tsup && bun ../../scripts/prepare-publish.ts prepack",
    "postpack": "bun ../../scripts/prepare-publish.ts postpack"
  }
}
