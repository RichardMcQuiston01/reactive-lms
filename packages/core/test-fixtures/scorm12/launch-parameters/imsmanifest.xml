  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>
  <organizations default="PARAMS-ORG">
    <organization identifier="PARAMS-ORG">
      <title>Course with launch parameters</title>
