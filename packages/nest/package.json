{
  "name": "@richardmcquiston01/reactive-lms-nest",
  "version": "0.4.0",
  "description": "NestJS module and HTTP API for ReactiveLMS.",
  "keywords": [
    "lms",
    "nestjs",
    "scorm",
    "aicc",
    "api"
  ],
  "license": "MIT",
  "author": "Richard McQuiston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/reactive-lms.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/RichardMcQuiston01/reactive-lms#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/reactive-lms/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "prepack": "tsup && bun ../../scripts/prepare-publish.ts prepack",
    "postpack": "bun ../../scripts/prepare-publish.ts postpack"
  },
  "dependencies": {
    "@richardmcquiston01/reactive-lms-core": "workspace:*",
    "@richardmcquiston01/reactive-lms-persistence": "workspace:*",
    "@richardmcquiston01/reactive-lms-shared": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  }
}
