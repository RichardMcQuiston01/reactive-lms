{
  "name": "reactive-lms",
  "version": "0.2.0",
  "description": "TypeScript LMS (SCORM, xAPI, cmi5, H5P, LTI) that runs standalone or embeds in a NestJS + Angular host.",
  "private": true,
  "license": "MIT",
  "author": "Richard McQuiston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/reactive-lms.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/P1V529Z7ZP"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/shared packages/persistence packages/core packages/nest packages/player packages/admin packages/standalone-api packages/standalone-web",
    "build": "bun run --filter './packages/shared' --filter './packages/persistence' --filter './packages/core' --filter './packages/nest' build",
    "verify:packages": "bun scripts/verify-packages.ts",
    "test": "bun test",
    "test:file": "bun test",
    "lint": "eslint .",
    "lint:file": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9",
    "@swc/core": "^1.16.22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^17.13.0",
    "prettier": "^3",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8"
  }
}
